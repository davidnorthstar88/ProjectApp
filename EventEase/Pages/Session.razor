@page "/session"
@inject UserSessionService SessionService

<h2>User Session</h2>

<div>
    <label>Your Name</label>
    <InputText @bind-Value="SessionService.Session.CurrentUserName" />
</div>

<p><strong>Last Viewed Event:</strong> @SessionService.Session.LastViewedEventId</p>
<p><strong>Registrations This Session:</strong> @SessionService.Session.RegistrationsCount</p>
