@page "/register/{eventId:int}"
@inject EventService EventService
@inject RegistrationService RegistrationService
@inject UserSessionService SessionService
@inject NavigationManager NavManager

<h2>Register for Event</h2>

@if (Event is null)
{
    <p>Event not found.</p>
}
else
{
    <p><strong>@Event.Name</strong> — @Event.Date.ToShortDateString()</p>

    <EditForm Model="@Registration" OnValidSubmit="Submit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div>
            <label>Full Name</label>
            <InputText @bind-Value="Registration.FullName" />
        </div>

        <div>
            <label>Email</label>
            <InputText @bind-Value="Registration.Email" />
        </div>

        <div>
            <label>Phone</label>
            <InputText @bind-Value="Registration.Phone" />
        </div>

        <div>
            <label>Tickets</label>
            <InputNumber @bind-Value="Registration.Tickets" />
        </div>

        <div>
            <InputCheckbox @bind-Value="Registration.AcceptedTerms" />
            <span>I accept the terms</span>
        </div>

        <button type="submit">Submit Registration</button>
    </EditForm>
}

@code {
    [Parameter] public int eventId { get; set; }

    private Event? Event;
    private Registration Registration = new();

    protected override void OnParametersSet()
    {
        Event = EventService.GetEventById(eventId);
        Registration.EventId = eventId;
    }

    private void Submit()
    {
        var saved = RegistrationService.Add(Registration);
        SessionService.IncrementRegistrations();
        NavManager.NavigateTo($"/registration-confirmation/{saved.Id}");
    }
}
