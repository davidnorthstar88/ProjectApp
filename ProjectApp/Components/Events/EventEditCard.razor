@using EventEase.Models
@inject EventService EventService
@inject NavigationManager NavManager

<h3>Edit Event</h3>

@if (EditableEvent is null)
{
    <p>Event not found.</p>
}
else
{
    <EditForm Model="@EditableEvent" OnValidSubmit="Save">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div>
            <label>Name</label>
            <InputText @bind-Value="EditableEvent.Name" />
        </div>

        <div>
            <label>Date</label>
            <InputDate @bind-Value="EditableEvent.Date" />
        </div>

        <div>
            <label>Location</label>
            <InputText @bind-Value="EditableEvent.Location" />
        </div>

        <div>
            <label>Capacity</label>
            <InputNumber @bind-Value="EditableEvent.Capacity" />
        </div>

        <div>
            <label>Description</label>
            <InputTextArea @bind-Value="EditableEvent.Description" />
        </div>

        <button type="submit">Save</button>
    </EditForm>
}

@code {
    [Parameter] public int EventId { get; set; }

    private Event? EditableEvent;

    protected override void OnParametersSet()
    {
        var ev = EventService.GetEventById(EventId);

        EditableEvent = ev is null
            ? null
            : new Event
            {
                Id = ev.Id,
                Name = ev.Name,
                Date = ev.Date,
                Location = ev.Location,
                Capacity = ev.Capacity,
                Description = ev.Description
            };
    }

    private void Save()
    {
        if (EditableEvent is null)
            return;

        EventService.UpdateEvent(EditableEvent);
        NavManager.NavigateTo("/events");
    }
}
